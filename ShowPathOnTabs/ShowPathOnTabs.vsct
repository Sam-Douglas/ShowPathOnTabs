<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidShowPathOnTabsPackage">

    <!-- Extensions > Show Path On Tabs, with Abbreviate Folders and Widen Tabs submenus -->
    <Menus>
      <Menu guid="guidShowPathOnTabsCmdSet" id="ExtensionsSubMenu" priority="0x0100" type="Menu">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_MM_TOOLSADDINS" />
        <Strings>
          <ButtonText>Show Path On Tabs</ButtonText>
        </Strings>
      </Menu>
      <Menu guid="guidShowPathOnTabsCmdSet" id="AbbreviateSubMenu" priority="0x0300" type="Menu">
        <Parent guid="guidShowPathOnTabsCmdSet" id="CaptionGroup" />
        <Strings>
          <ButtonText>Abbreviate Folders</ButtonText>
        </Strings>
      </Menu>
      <Menu guid="guidShowPathOnTabsCmdSet" id="WidenSubMenu" priority="0x0350" type="Menu">
        <Parent guid="guidShowPathOnTabsCmdSet" id="CaptionGroup" />
        <Strings>
          <ButtonText>Widen Tabs</ButtonText>
        </Strings>
      </Menu>
    </Menus>

    <Groups>
      <Group guid="guidShowPathOnTabsCmdSet" id="CaptionGroup" priority="0x0100">
        <Parent guid="guidShowPathOnTabsCmdSet" id="ExtensionsSubMenu" />
      </Group>
      <Group guid="guidShowPathOnTabsCmdSet" id="SettingsGroup" priority="0x0200">
        <Parent guid="guidShowPathOnTabsCmdSet" id="ExtensionsSubMenu" />
      </Group>
      <Group guid="guidShowPathOnTabsCmdSet" id="AbbreviateGroup" priority="0x0100">
        <Parent guid="guidShowPathOnTabsCmdSet" id="AbbreviateSubMenu" />
      </Group>
      <Group guid="guidShowPathOnTabsCmdSet" id="WidenGroup" priority="0x0100">
        <Parent guid="guidShowPathOnTabsCmdSet" id="WidenSubMenu" />
      </Group>
    </Groups>

    <Buttons>
      <!-- Independent settings: each one is ticked or not. -->
      <Button guid="guidShowPathOnTabsCmdSet" id="CollapseMiddleCommand" priority="0x0200" type="Button">
        <Parent guid="guidShowPathOnTabsCmdSet" id="CaptionGroup" />
        <Strings>
          <ButtonText>Collapse Middle Folders</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidShowPathOnTabsCmdSet" id="FileNameFirstCommand" priority="0x0400" type="Button">
        <Parent guid="guidShowPathOnTabsCmdSet" id="CaptionGroup" />
        <Strings>
          <ButtonText>File Name First</ButtonText>
        </Strings>
      </Button>

      <!-- One choice in each submenu is ticked. -->
      <Button guid="guidShowPathOnTabsCmdSet" id="AbbreviateOffCommand" priority="0x0100" type="Button">
        <Parent guid="guidShowPathOnTabsCmdSet" id="AbbreviateGroup" />
        <Strings>
          <ButtonText>Off</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidShowPathOnTabsCmdSet" id="AbbreviateToFitCommand" priority="0x0200" type="Button">
        <Parent guid="guidShowPathOnTabsCmdSet" id="AbbreviateGroup" />
        <Strings>
          <ButtonText>To Fit</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidShowPathOnTabsCmdSet" id="AbbreviateAlwaysCommand" priority="0x0300" type="Button">
        <Parent guid="guidShowPathOnTabsCmdSet" id="AbbreviateGroup" />
        <Strings>
          <ButtonText>Always</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidShowPathOnTabsCmdSet" id="WidenOffCommand" priority="0x0100" type="Button">
        <Parent guid="guidShowPathOnTabsCmdSet" id="WidenGroup" />
        <Strings>
          <ButtonText>Off</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidShowPathOnTabsCmdSet" id="WidenToFitCommand" priority="0x0200" type="Button">
        <Parent guid="guidShowPathOnTabsCmdSet" id="WidenGroup" />
        <Strings>
          <ButtonText>To Fit</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidShowPathOnTabsCmdSet" id="WidenToLimitCommand" priority="0x0300" type="Button">
        <Parent guid="guidShowPathOnTabsCmdSet" id="WidenGroup" />
        <Strings>
          <ButtonText>To Limit</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidShowPathOnTabsCmdSet" id="OpenSettingsCommand" priority="0x0100" type="Button">
        <Parent guid="guidShowPathOnTabsCmdSet" id="SettingsGroup" />
        <Strings>
          <ButtonText>Settings...</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

